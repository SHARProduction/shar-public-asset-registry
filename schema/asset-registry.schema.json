{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharprod.com/schemas/shar-public-asset-registry.schema.json",
  "title": "SHAR_PUBLIC_ASSET_REGISTRY",
  "description": "Canonical public asset registry for SHAR Production. Statuses are evidence-gated; unsupported acceptance conditions lower status.",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "title",
    "brand",
    "status_definitions",
    "scope",
    "updated_at",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "const": "SHAR_PUBLIC_ASSET_REGISTRY"
    },
    "title": {
      "const": "SHAR Production Public Asset Registry"
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "website"
      ],
      "properties": {
        "name": {
          "const": "SHAR Production"
        },
        "website": {
          "const": "https://sharprod.com/"
        }
      },
      "additionalProperties": false
    },
    "status_definitions": {
      "type": "object",
      "required": [
        "PLANNED",
        "LOCAL_READY",
        "AWAITING_OWNER",
        "SUBMITTED",
        "PUBLISHED_VERIFIED",
        "MEASURED",
        "BLOCKED",
        "REJECTED_WITH_REASON"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_type",
          "title",
          "title_ru",
          "owner",
          "brand",
          "provider",
          "namespace",
          "public_url",
          "canonical_url",
          "version",
          "visibility",
          "license",
          "status",
          "evidence_class",
          "verified_at",
          "verification_method",
          "verification",
          "languages",
          "relationships",
          "content_summary",
          "notes",
          "next_review"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^shar-public\\.asset\\.[a-z0-9.-]+$"
          },
          "asset_type": {
            "enum": [
              "website",
              "mcp_service",
              "browser_tool",
              "github_profile",
              "github_repository",
              "huggingface_dataset",
              "huggingface_space"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "title_ru": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "const": "SHAR Production"
          },
          "brand": {
            "type": "object",
            "required": [
              "name",
              "website"
            ],
            "properties": {
              "name": {
                "const": "SHAR Production"
              },
              "website": {
                "const": "https://sharprod.com/"
              }
            },
            "additionalProperties": false
          },
          "provider": {
            "enum": [
              "self_hosted",
              "GitHub",
              "Hugging Face",
              "Cloudflare Workers"
            ]
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "public_url": {
            "type": "string",
            "format": "uri"
          },
          "canonical_url": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "content_sha256",
                  "git_commit",
                  "hub_commit",
                  "release_tag",
                  "semantic"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "visibility": {
            "const": "public"
          },
          "license": {
            "enum": [
              "MIT",
              "CC-BY-4.0",
              "MIXED",
              "UNSUPPORTED"
            ]
          },
          "status": {
            "enum": [
              "PLANNED",
              "LOCAL_READY",
              "AWAITING_OWNER",
              "SUBMITTED",
              "PUBLISHED_VERIFIED",
              "MEASURED",
              "BLOCKED",
              "REJECTED_WITH_REASON"
            ]
          },
          "evidence_class": {
            "enum": [
              "LIVE_HTTP_CHECK",
              "PROVIDER_API_CHECK",
              "LIVE_PROTOCOL_CHECK",
              "PARTIAL_PROVIDER_CHECK"
            ]
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification_method": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "object",
            "required": [
              "outcome",
              "http_status",
              "content_checked",
              "function_checked",
              "owner_checked",
              "version_checked",
              "details"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "PASS",
                  "PARTIAL",
                  "FAIL",
                  "UNASSESSED"
                ]
              },
              "http_status": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "content_checked": {
                "type": "boolean"
              },
              "function_checked": {
                "type": "boolean"
              },
              "owner_checked": {
                "type": "boolean"
              },
              "version_checked": {
                "type": "boolean"
              },
              "details": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ru",
                "en",
                "language-neutral"
              ]
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "relation",
                "target"
              ],
              "properties": {
                "relation": {
                  "enum": [
                    "owned_by",
                    "links_to",
                    "source_for",
                    "companion_to",
                    "deployed_from"
                  ]
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "content_summary": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_review": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
